{
  "name": "4way-safety-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "React + Vite frontend for 4Way Safety Solutions LLP, powered by headless WordPress.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude src/test/live-wordpress.test.jsx",
    "test:watch": "vitest",
    "test:live": "LIVE_WP_URL=1 vitest run src/test/live-wordpress.test.jsx",
    "wp:defaults": "node ../scripts/export-wp-defaults.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^24.1.1",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.3",
    "vitest": "^2.0.5"
  }
}

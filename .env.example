# Copied for `docker compose`. Adjust for production.
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root

# Ports
WP_PORT=8080
FRONTEND_PORT=5173

# Where WordPress sends visitors (the React app)
FOURWAY_FRONTEND_URL=http://localhost:5173

# First-run WordPress administrator
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=4way-admin-password
WP_ADMIN_EMAIL=support@4waysafety.com
